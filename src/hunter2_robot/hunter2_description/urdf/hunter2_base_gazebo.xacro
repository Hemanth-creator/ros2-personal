<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
  name="hunter2_base">

<link name="base_link" />

  <!-- chassis Link -->
  <link name="chassis">
    <inertial>
      <origin
        xyz="0.0266989327622036 0.000409203500587652 -0.135901124750884"
        rpy="0 0 0" />
      <mass
        value="21.02945169536679" />
      <inertia
        ixx="0.0332370959804736"
        ixy="-1.013150489971E-06"
        ixz="-0.00188859201421112"
        iyy="0.111072002332437"
        iyz="-5.13308150598312E-07"
        izz="0.12660862809283" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <!-- <mesh filename="file://$(find hunter2_robot)/hunter2_description/meshes/base_link.STL" /> -->
        <box size="0.98 0.745 0.38"/> <!-- W x H x D in meters -->
      </geometry>
      <material
        name="">
        <color
          rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <box size="0.98 0.745 0.38"/> <!-- W x H x D in meters -->
      </geometry>
    </collision>
  </link>
  <!-- chassis joint -->
  <joint name="chassis_joint" type="fixed">
    <origin xyz="0.8 0 0.5" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="chassis" />
  </joint>
  <!-- rear left wheel Link -->
  <link
    name="left_rear_link">
    <inertial>
      <origin
        xyz="-8.826E-05 6.4342E-05 -0.0096491"
        rpy="0 0 0" />
      <mass
        value="7.6692" />
      <inertia
        ixx="0.063699"
        ixy="0"
        ixz="0"
        iyy="0.063699"
        iyz="0"
        izz="0.11067" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <!-- <mesh filename="file://$(find hunter2_robot)/hunter2_description/meshes/left_rear_link.STL" /> -->
        <cylinder radius="0.065" length="0.05"/>
      </geometry>
      <material
        name="">
        <color
          rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.065" length="0.05"/>
      </geometry>
    </collision>
  </link>
  <!-- rear left  Link -->
  <joint
    name="left_rear_joint"
    type="continuous">
    <origin
      xyz="-0.28 0.29249 -0.19558"
      rpy="1.5708 0 0" />
    <parent
      link="chassis" />
    <child
      link="left_rear_link" />
    <axis
      xyz="0 0 -1" />
     <dynamics damping="0.0" friction="15"/>
  </joint>
  <!-- right_rear_link -->
  <link
    name="right_rear_link">
    <inertial>
      <origin
        xyz="8.6344E-05 7.4488E-05 0.0097824"
        rpy="0 0 0" />
      <mass
        value="7.7133" />
      <inertia
        ixx="0.06373"
        ixy="0"
        ixz="0"
        iyy="0.06373"
        iyz="0"
        izz="0.11073" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <!-- <mesh filename="file://$(find hunter2_robot)/hunter2_description/meshes/right_rear_link.STL" /> -->
        <cylinder radius="0.065" length="0.05"/>
      </geometry>
      <material
        name="">
        <color
          rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.065" length="0.05"/>
      </geometry>
    </collision>
  </link>
  <!-- right_rear_join-->
  <joint
    name="right_rear_joint"
    type="continuous">
    <origin
      xyz="-0.28018 -0.29251 -0.19558"
      rpy="1.5708 0.0026575 0" />
    <parent
      link="chassis" />
    <child
      link="right_rear_link" />
    <axis
      xyz="0 0 -1" />
     <dynamics damping="0.0" friction="15"/>
  </joint>
  <!-- left steer Link -->
  <link
    name="front_steer_left_link">
    <inertial>
      <origin
        xyz="-0.012614 1.8116E-05 0.0023132"
        rpy="0 0 0" />
      <mass
        value="7.8526" />
      <inertia
        ixx="0.063827"
        ixy="0"
        ixz="0"
        iyy="0.063827"
        iyz="0"
        izz="0.11091" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
      <cylinder length="0.001" radius="0.005"/>
      </geometry>
      <material
        name="">
        <color
          rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
      <cylinder length="0.001" radius="0.005"/>
      </geometry>
    </collision>
  </link>
  <!-- left steer joint -->
  <joint
    name="front_steer_left_joint"
    type="revolute">
    <origin
      xyz="0.37142 0.29199 -0.1955"
      rpy="1.5708 0 0" />
    <parent
      link="chassis" />
    <child
      link="front_steer_left_link" />
    <axis
      xyz="0 1 0" />
    <limit
      lower="-0.69"
      upper="0.69"
      effort="0"
      velocity="0" />
  </joint>
  <!-- right steer Link -->
   <link
    name="front_steer_right_link">
    <inertial>
      <origin
        xyz="-8.9374E-08 1.0997E-07 0.0095958"
        rpy="0 0 0" />
      <mass
        value="7.696" />
      <inertia
        ixx="0.063704"
        ixy="0"
        ixz="0"
        iyy="0.063704"
        iyz="0"
        izz="0.11068" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
      <cylinder length="0.001" radius="0.005"/>
      </geometry>
      <material
        name="">
        <color
          rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
      <cylinder length="0.001" radius="0.005"/>
      </geometry>
    </collision>
  </link>
  <!-- right steer Joint -->
  <joint
    name="front_steer_right_joint"
    type="revolute">
    <origin
      xyz="0.37142 -0.29201 -0.1955"
      rpy="1.5708 0 0" />
    <parent
      link="chassis" />
    <child
      link="front_steer_right_link" />
    <axis
      xyz="0 1 0" />
    <limit
      lower="-0.69"
      upper="0.69"
      effort="0"
      velocity="0" />
  </joint>
<!-- front left wheel Link -->
  <link
    name="front_left_wheel_link">
    <inertial>
      <origin
        xyz="-6.5774E-06 2.0242E-05 -0.0096386"
        rpy="0 0 0" />
      <mass
        value="7.7007" />
      <inertia
        ixx="0.063724"
        ixy="0"
        ixz="0"
        iyy="0.063724"
        iyz="0"
        izz="0.11072" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <!-- <mesh filename="file://$(find hunter2_robot)/hunter2_description/meshes/front_left_wheel_link.STL" /> -->
        <cylinder radius="0.065" length="0.05"/> <!-- radius ~ half wheel diameter, length ~ wheel thickness -->
      </geometry>
      <material
        name="">
        <color
          rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.065" length="0.05"/> <!-- radius ~ half wheel diameter, length ~ wheel thickness -->
      </geometry>
    </collision>
  </link>
  <!-- front left wheel Joint -->
  <joint
    name="front_left_wheel_joint"
    type="continuous">
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <parent
      link="front_steer_left_link" />
    <child
      link="front_left_wheel_link" />
    <axis
      xyz="0 0 -1" />
      <dynamics damping="0.0" friction="15"/>
  </joint>
  <!-- front right wheel Link -->
  <link
    name="front_right_wheel_link">
    <inertial>
      <origin
        xyz="-9.1148E-08 1.1284E-07 0.0095049"
        rpy="0 0 0" />
      <mass
        value="7.5613" />
      <inertia
        ixx="0.063626"
        ixy="0"
        ixz="0"
        iyy="0.063626"
        iyz="0"
        izz="0.11054" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 3.14 0" />
      <geometry>
        <!-- <mesh filename="file://$(find hunter2_robot)/hunter2_description/meshes/front_left_wheel_link.STL" /> -->
        <cylinder radius="0.065" length="0.05"/>
      </geometry>
      <material
        name="">
        <color
          rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.065" length="0.05"/>
      </geometry>
    </collision>
  </link>
  <!-- front right wheel joint -->
  <joint
    name="front_right_wheel_joint"
    type="continuous">
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <parent
      link="front_steer_right_link" />
    <child
      link="front_right_wheel_link" />
    <axis
      xyz="0 0 -1" />
      <dynamics damping="0.0" friction="15"/>
  </joint>
  
  
