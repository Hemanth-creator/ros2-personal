<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
  name="hunter2_base">

<material name="Black">
    <color rgba="0 0 0 1" />
  </material>
<material name="Aluminum">
    <color rgba="0.9 0.9 0.95 1"/>   <!-- base color: very light gray/white -->
    <specular rgba="0.95 0.95 0.95 1"/> <!-- shiny reflection highlight -->
    <emission rgba="0 0 0 1"/>         <!-- no self-emission -->
  </material>


<link name="base_link" />

  <!-- chassis Link -->
  <link name="chassis">
    <inertial>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <mass
        value="21.02945169536679" />
      <inertia
        ixx="0.0332370959804736"
        ixy="-1.013150489971E-06"
        ixz="-0.00188859201421112"
        iyy="0.111072002332437"
        iyz="-5.13308150598312E-07"
        izz="0.12660862809283" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find hunter2_robot)/hunter2_description/meshes/base_link.STL" />
        <!-- <box size="0.98 0.3 0.27"/>  -->
      </geometry>
      <material
        name="Aluminum">
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <box size="0.98 0.3 0.27"/>
      </geometry>
    </collision>
  </link>
  <!-- chassis joint -->
  <joint name="chassis_joint" type="fixed">
    <origin xyz="0 0 0.37" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="chassis" />
  </joint>
  <!-- rear left wheel Link -->
  <link
    name="left_rear_link">
    <collision>
      <geometry>
        <cylinder radius="0.165" length="0.14"/>
      </geometry>
    </collision>
    <visual>
      <geometry>
        <mesh filename="file://$(find hunter2_robot)/hunter2_description/meshes/left_rear_link.STL" />
        <!-- <cylinder radius="0.165" length="0.14"/> -->
      </geometry>
      <material
        name="Black">
      </material>
    </visual>
    <inertial>
      <mass
        value="7.6692" />
      <inertia
        ixx="0.063699"
        ixy="0"
        ixz="0"
        iyy="0.063699"
        iyz="0"
        izz="0.11067" />
    </inertial>
  </link>
  <!-- rear left  JOINT -->
  <joint
    name="left_rear_joint"
    type="continuous">
    <origin
      xyz="-0.28 0.29249 -0.165"
      rpy="-1.57 0 0" />
    <parent
      link="chassis" />
    <child
      link="left_rear_link" />
    <axis
      xyz="0 0 1 "/>
     <dynamics damping="0" friction="15"/>
  </joint>


  <!-- right_rear_link -->
  <link
    name="right_rear_link">
     <collision>
      <geometry>
        <cylinder radius="0.165" length="0.14"/>
      </geometry>
    </collision>
     <visual>
      <geometry>
        <mesh filename="file://$(find hunter2_robot)/hunter2_description/meshes/right_rear_link.STL" />
        <!-- <cylinder radius="0.165" length="0.14"/> -->
      </geometry>
      <material
        name="Black">
      </material>
    </visual>
    <inertial>
      <mass
        value="7.7133" />
      <inertia
        ixx="0.06373"
        ixy="0"
        ixz="0"
        iyy="0.06373"
        iyz="0"
        izz="0.11073" />
    </inertial>
  </link>

  <!-- right_rear_join-->
  <joint
    name="right_rear_joint"
    type="continuous">
    <origin
      xyz="-0.28018 -0.29251 -0.165"
      rpy="-1.57 0 0" />
    <parent
      link="chassis" />
    <child
      link="right_rear_link" />
    <axis
      xyz="0 0 1 "/>
     <dynamics damping="0" friction="15"/>
  </joint>


  <!-- left steer Link -->
  <link
    name="front_steer_left_link">
    <inertial>
      <mass
        value="7.8526" />
      <inertia
        ixx="0.063827"
        ixy="0"
        ixz="0"
        iyy="0.063827"
        iyz="0"
        izz="0.11091" />
    </inertial>
  </link>

  <!-- left steer joint -->
  <joint
    name="front_steer_left_joint"
    type="revolute">
    <origin
      xyz="0.37142 0.29199 -0.165"
      rpy="0 0 0" />
    <parent
      link="chassis" />
    <child
      link="front_steer_left_link" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-0.436"
      upper="0.436"
      effort="80"
      velocity="20" />
  </joint>

  <!-- right steer Link -->
   <link
    name="front_steer_right_link">
    <inertial>
      <mass
        value="7.696" />
      <inertia
        ixx="0.063704"
        ixy="0"
        ixz="0"
        iyy="0.063704"
        iyz="0"
        izz="0.11068" />
    </inertial>
    
  </link>

  <!-- right steer Joint -->
  <joint
    name="front_steer_right_joint"
    type="revolute">
    <origin
      xyz="0.37142 -0.29201 -0.165"
      rpy="0 0 0" />
    <parent
      link="chassis" />
    <child
      link="front_steer_right_link" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-0.436"
      upper="0.436"
      effort="80.0"
      velocity="2.0" />
  </joint>

<!-- front left wheel Link -->
  <link
    name="front_left_wheel_link">
    <collision>
      <geometry>
        <cylinder radius="0.165" length="0.14"/> <!-- radius ~ half wheel diameter, length ~ wheel thickness -->
      </geometry>
    </collision>
    <visual>
      <geometry>
        <mesh filename="file://$(find hunter2_robot)/hunter2_description/meshes/front_left_wheel_link.STL" />
        <!-- <cylinder radius="0.165" length="0.14"/>  -->
      </geometry>
      <material
        name="Black">
      </material>
    </visual>
    <inertial>
      <mass
        value="7.7007" />
      <inertia
        ixx="0.063724"
        ixy="0"
        ixz="0"
        iyy="0.063724"
        iyz="0"
        izz="0.11072" />
    </inertial>
  </link>

  <!-- front left wheel Joint -->
  <joint
    name="front_left_wheel_joint"
    type="continuous">
    <origin
      xyz="0 0 0"
      rpy="-1.57 0 0" />
    <parent
      link="front_steer_left_link" />
    <child
      link="front_left_wheel_link" />
    <axis
      xyz="0 0 1 "/>
      <dynamics damping="0" friction="15"/>
  </joint>

  <!-- front right wheel Link -->
  <link
    name="front_right_wheel_link">
    <collision>
      <geometry>
        <cylinder radius="0.165" length="0.14"/>
      </geometry>
    </collision>
    <visual>
      <geometry>
        <mesh filename="file://$(find hunter2_robot)/hunter2_description/meshes/front_left_wheel_link.STL" />
        <!-- <cylinder radius="0.165" length="0.14"/> -->
      </geometry>
      <material
        name="Black">
      </material>
    </visual>
    <inertial>
      <mass
        value="7.5613" />
      <inertia
        ixx="0.063626"
        ixy="0"
        ixz="0"
        iyy="0.063626"
        iyz="0"
        izz="0.11054" />
    </inertial>
  </link>

  <!-- front right wheel joint -->
  <joint
    name="front_right_wheel_joint"
    type="continuous">
    <origin
      xyz="0 0 0"
      rpy="-1.57 0 0" />
    <parent
      link="front_steer_right_link" />
    <child
      link="front_right_wheel_link" />
    <axis
      xyz="0 0 1 " />
      <dynamics damping="0" friction="15"/>
  </joint>
  
<gazebo reference="left_rear_link">
  <mu1>1.2</mu1>        <!-- lateral friction -->
  <mu2>1.2</mu2>        <!-- longitudinal friction -->
  <kp>300000</kp>       <!-- contact stiffness -->
  <kd>3</kd>            <!-- contact damping -->
</gazebo>

<gazebo reference="right_rear_link">
  <mu1>1.2</mu1>
  <mu2>1.2</mu2>
  <kp>300000</kp>
  <kd>3</kd>
</gazebo>

<gazebo reference="front_left_wheel_link">
  <mu1>1.2</mu1>
  <mu2>1.2</mu2>
  <kp>300000</kp>
  <kd>3</kd>
</gazebo>

<gazebo reference="front_right_wheel_link">
  <mu1>1.2</mu1>
  <mu2>1.2</mu2>
  <kp>300000</kp>
  <kd>3</kd>
</gazebo>

<xacro:arg name="sim_gazebo" default="classic"/>
<ros2_control name="GazeboSystem" type="system"> 
  <hardware> 
    <plugin>gz_ros2_control/GazeboSimSystem</plugin> 
  </hardware>

<!-- Rear wheels -->
<joint name="left_rear_joint">
  <command_interface name="velocity"/>
  <state_interface name="velocity"/>
  <state_interface name="position"/>
</joint>
<joint name="right_rear_joint">
  <command_interface name="velocity"/>
  <state_interface name="velocity"/>
  <state_interface name="position"/>
</joint>

<!-- Front steering joints -->
<joint name="front_steer_left_joint">
  <command_interface name="position"/>
  <state_interface name="position"/>
</joint>
<joint name="front_steer_right_joint">
  <command_interface name="position"/>
  <state_interface name="position"/>
</joint>

<!-- Front wheels -->
<joint name="front_left_wheel_joint">
  <state_interface name="velocity"/>
  <state_interface name="position"/>
</joint>
<joint name="front_right_wheel_joint">
  <state_interface name="velocity"/>
  <state_interface name="position"/>
</joint>

</ros2_control>

<xacro:if value="$(eval sim_gazebo == 'sim')"> 
  <gazebo> 
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin"> 
      <parameters>$(find hunter2_robot)/config/ackermann_like_controller.yaml</parameters>
     </plugin>
  </gazebo>
</xacro:if>

</robot>
